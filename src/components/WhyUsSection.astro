---
import SectionWrapper from './base/SectionWrapper.astro';

const reasons = [
  {
    emoji: '🚚',
    title: 'Livraison & montage inclus',
    body: 'Nous livrons, installons et démontions tout le matériel. Pas de mauvaise surprise sur place.',
  },
  {
    emoji: '📍',
    title: 'Ancré en Alsace',
    body: "Strasbourg, Colmar, Mulhouse et tous les villages entre les deux — on connaît le terrain.",
  },
  {
    emoji: '✅',
    title: 'Matériel premium certifié',
    body: 'Gonflables aux normes CE, entretien régulier, hygiène irréprochable. Votre sécurité avant tout.',
  },
  {
    emoji: '⚡',
    title: 'Disponibilité & réactivité',
    body: "Devis sous 24h, confirmation rapide. On s'adapte à vos contraintes de dernière minute.",
  },
];
---

<SectionWrapper id="why-us">
  <div class="text-center mb-12">
    <p class="fade-up text-coral text-sm font-semibold uppercase tracking-widest mb-3">Pourquoi nous</p>
    <h2 class="fade-up font-display text-4xl md:text-5xl font-bold leading-tight" style="transition-delay:0.1s">
      Le bon choix pour votre fête
    </h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {reasons.map((reason, i) => (
      <div
        class="fade-up bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow text-center"
        style={`transition-delay:${i * 0.1}s`}
      >
        <span class="text-4xl mb-4 block">{reason.emoji}</span>
        <h3 class="font-display font-bold text-lg text-deep mb-2">{reason.title}</h3>
        <p class="text-muted text-sm leading-relaxed">{reason.body}</p>
      </div>
    ))}
  </div>
</SectionWrapper>
