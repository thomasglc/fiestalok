---
const links = [
  { label: 'À propos', href: '#about' },
  { label: 'Catalogue', href: '#catalogue' },
  { label: 'Pourquoi nous', href: '#why-us' },
  { label: "Zone d'intervention", href: '#zone' },
  { label: 'Contact', href: '#contact' },
];

const socials = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/profile.php?id=61572126636123',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>`,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/fiestalok.strasbourg/',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-deep text-cream/60 pt-16 pb-8 px-4 md:px-8">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-10 pb-10 border-b border-white/10">
      <div>
        <p class="font-display text-2xl font-bold text-cream mb-3">
          Fiestalo <span class="text-coral">k</span>
        </p>
        <p class="text-sm leading-relaxed max-w-xs">
          Location de matériel festif à Strasbourg et en Alsace. Livraison, montage et démontage inclus.
        </p>
      </div>

      <nav aria-label="Liens du site">
        <p class="text-cream text-sm font-semibold mb-4">Navigation</p>
        <ul class="space-y-2">
          {links.map(link => (
            <li>
              <a href={link.href} class="text-sm hover:text-coral transition-colors">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="text-cream text-sm font-semibold mb-4">Contact</p>
        <address class="not-italic space-y-2 text-sm">
          <p>📍 Strasbourg, Alsace</p>
          <p>✉️ <a href="mailto:contact@fiestalok.fr" class="hover:text-coral transition-colors">contact@fiestalok.fr</a></p>
        </address>
        <div class="flex gap-3 mt-5">
          {socials.map(social => (
            <a
              href={social.href}
              aria-label={social.label}
              class="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center hover:bg-coral transition-colors"
              set:html={social.svg}
            />
          ))}
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <p>© {year} Fiestalo k — Tous droits réservés</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-coral transition-colors">Mentions légales</a>
        <a href="#" class="hover:text-coral transition-colors">Politique de confidentialité</a>
        <a href="#" class="hover:text-coral transition-colors">CGV</a>
      </div>
    </div>
  </div>
</footer>
