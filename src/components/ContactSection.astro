---
import SectionWrapper from './base/SectionWrapper.astro';
---

<SectionWrapper id="contact" narrow>
  <div class="text-center">
    <p class="fade-up text-coral text-sm font-semibold uppercase tracking-widest mb-3">Contact</p>
    <h2 class="fade-up font-display text-4xl md:text-5xl font-bold leading-tight mb-4" style="transition-delay:0.1s">
      Contactez-nous
    </h2>
    <p class="fade-up text-muted mb-8" style="transition-delay:0.2s">
      Pour toute demande de disponibilité ou de devis, écrivez-nous directement.
    </p>
    <a
      href="mailto:contact@fiestalok.fr"
      class="fade-up inline-flex items-center justify-center font-sans font-semibold text-base tracking-wide px-8 py-4 rounded-full bg-coral text-white hover:bg-coral-dark active:scale-95 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-coral focus:ring-offset-2"
      style="transition-delay:0.3s"
    >
      contact@fiestalok.fr
    </a>
  </div>
</SectionWrapper>
